<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OSAKA TRIO 2026 | 職人漫遊指揮中心</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700&family=Inter:wght@300;400;600;800&family=JetBrains+Mono&display=swap');

        :root {
            --sakura-primary: #fce4ec;
            --sakura-accent: #ffb7c5;
            --japan-red: #bc002d;
            --deep-slate: #1e293b;
            --soft-blue: #e3f2fd;
        }

        body {
            font-family: 'Inter', 'Noto Serif TC', serif;
            background-color: #fdfdfd;
            color: var(--deep-slate);
            scroll-behavior: smooth;
        }

        /* 櫻花飄落背景 */
        .sakura-container {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; z-index: -1;
        }

        .petal {
            position: absolute; background-color: var(--sakura-primary);
            border-radius: 150% 0 150% 0; opacity: 0.6;
            animation: fall linear infinite;
        }

        @keyframes fall {
            0% { transform: translateY(-10vh) rotate(0deg); opacity: 0; }
            10% { opacity: 1; }
            100% { transform: translateY(105vh) rotate(360deg); opacity: 0; }
        }

        /* 專業側邊導航 (參考九州網頁風格) */
        .sidebar {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            border-right: 1px solid rgba(0, 0, 0, 0.05);
        }

        .nav-link {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 10px;
            color: #64748b;
            font-weight: 500;
        }

        .nav-link:hover, .nav-link.active {
            background: #fff5f7;
            color: var(--japan-red);
            padding-left: 1.5rem;
        }

        /* 卡片設計 */
        .glass-card {
            background: white;
            border: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            border-radius: 20px;
        }

        .itinerary-step {
            position: relative;
            padding-left: 2.5rem;
            margin-bottom: 1.5rem;
        }

        .itinerary-step::before {
            content: '';
            position: absolute; left: 0; top: 0;
            width: 24px; height: 24px;
            background: var(--sakura-primary);
            border: 2px solid var(--japan-red);
            border-radius: 50%;
            z-index: 2;
        }

        .itinerary-step::after {
            content: '';
            position: absolute; left: 11px; top: 24px;
            width: 2px; height: calc(100% + 0.5rem);
            background: #f1f5f9;
            z-index: 1;
        }

        .itinerary-step:last-child::after { display: none; }

        .flight-container {
            background: linear-gradient(135deg, #ffffff 0%, #fff5f7 100%);
        }

        .hero-banner {
            border-radius: 30px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }

        @media (max-width: 1024px) {
            .sidebar { display: none; }
        }
    </style>
</head>
<body class="flex min-h-screen">

    <div class="sakura-container" id="sakura-box"></div>

    <!-- Sidebar Navigation -->
    <aside class="sidebar w-80 h-screen sticky top-0 p-8 flex flex-col hidden lg:flex">
        <div class="mb-12 flex items-center gap-4">
            <img src="image_78428c.jpg" alt="Logo" class="w-14 h-14 rounded-full object-cover border-2 border-pink-100 shadow-sm">
            <div>
                <h1 class="font-black text-xl tracking-tight text-slate-800">OSAKA 2026</h1>
                <p class="text-[10px] uppercase font-bold text-red-500 tracking-widest">櫻花漫遊 · 指揮中心</p>
            </div>
        </div>

        <nav class="space-y-1 flex-grow overflow-y-auto pr-2">
            <a href="#overview" class="nav-link flex items-center gap-3 p-3 active">
                <i class="fas fa-home-alt w-5"></i> 總覽
            </a>
            <a href="#flight" class="nav-link flex items-center gap-3 p-3">
                <i class="fas fa-plane-departure w-5"></i> 航班資訊
            </a>
            <a href="#stay" class="nav-link flex items-center gap-3 p-3">
                <i class="fas fa-bed w-5"></i> 住宿基地
            </a>
            <div class="pt-4 pb-2 text-[10px] font-black text-slate-400 uppercase tracking-widest">七日行程表</div>
            <a href="#day1" class="nav-link flex items-center gap-3 p-3 text-sm">
                <span class="w-5 text-center font-bold">01</span> 5/08 系統上線
            </a>
            <a href="#day2" class="nav-link flex items-center gap-3 p-3 text-sm">
                <span class="w-5 text-center font-bold">02</span> 5/09 姬路城/神戶
            </a>
            <a href="#day3" class="nav-link flex items-center gap-3 p-3 text-sm">
                <span class="w-5 text-center font-bold">03</span> 5/10 天橋立/伊根
            </a>
            <a href="#day4" class="nav-link flex items-center gap-3 p-3 text-sm">
                <span class="w-5 text-center font-bold">04</span> 5/11 嵐山小火車
            </a>
            <a href="#day5" class="nav-link flex items-center gap-3 p-3 text-sm">
                <span class="w-5 text-center font-bold">05</span> 5/12 京都/宇治
            </a>
            <a href="#day6" class="nav-link flex items-center gap-3 p-3 text-sm">
                <span class="w-5 text-center font-bold">06</span> 5/13 大阪市區
            </a>
            <a href="#day7" class="nav-link flex items-center gap-3 p-3 text-sm">
                <span class="w-5 text-center font-bold">07</span> 5/14 登出回傳
            </a>
        </nav>

        <div class="mt-8 pt-6 border-t border-slate-100 text-[10px] text-slate-400 font-mono">
            MISSION HUB VER 4.0 // 2026-05
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-grow p-4 md:p-12 lg:p-16 max-w-7xl mx-auto">
        
        <!-- Overview -->
        <section id="overview" class="mb-24">
            <div class="flex flex-col xl:flex-row gap-16 items-center">
                <div class="xl:w-3/5">
                    <span class="inline-block px-4 py-1 bg-red-100 text-red-600 rounded-full text-xs font-black mb-6 tracking-widest uppercase">Mission Briefing</span>
                    <h2 class="text-6xl font-black text-slate-900 leading-tight mb-8">
                        拋妻拋子<br><span class="text-transparent bg-clip-text bg-gradient-to-r from-red-600 to-pink-500 italic">2026 大阪三人行</span>
                    </h2>
                    <p class="text-lg text-slate-500 leading-relaxed mb-10 max-w-2xl">
                        這是一場專屬於男人的純粹旅程。從大國町出發，橫跨關西廣域，結合電信工程師的精準規劃與日本職人精神，將 2026 的櫻花與美景悉數收藏。
                    </p>
                    <div class="flex flex-wrap gap-6">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-red-50 rounded-2xl flex items-center justify-center text-red-600 text-xl shadow-sm">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="text-sm">
                                <div class="text-slate-400 font-bold uppercase text-[10px]">Team Size</div>
                                <div class="font-black">3 成年男子</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-600 text-xl shadow-sm">
                                <i class="fas fa-id-card"></i>
                            </div>
                            <div class="text-sm">
                                <div class="text-slate-400 font-bold uppercase text-[10px]">Transport</div>
                                <div class="font-black">JR West Pass 5D</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="xl:w-2/5">
                    <img src="image_78428c.jpg" alt="Hero" class="hero-banner w-full h-auto object-cover transform rotate-1 shadow-2xl">
                </div>
            </div>
        </section>

        <!-- Flight Section -->
        <section id="flight" class="mb-24 scroll-mt-20">
            <div class="flex items-center gap-6 mb-12">
                <h3 class="text-3xl font-black text-slate-900">航班資訊</h3>
                <div class="h-[2px] flex-grow bg-slate-100"></div>
                <span class="text-xs font-bold text-slate-400 tracking-widest uppercase">EVA Air Schedule</span>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Flight Go -->
                <div class="glass-card flight-container p-10 relative overflow-hidden group">
                    <div class="flex justify-between items-start mb-10">
                        <div class="bg-red-600 text-white px-4 py-1 rounded-full text-[10px] font-black tracking-widest uppercase">EVA AIR BR130</div>
                        <span class="text-sm font-bold text-slate-400">2026/05/08 (Fri)</span>
                    </div>
                    <div class="flex justify-between items-center mb-8 relative">
                        <div class="text-center z-10">
                            <div class="text-4xl font-black italic tracking-tighter">15:35</div>
                            <div class="text-[10px] font-bold text-slate-400 mt-2 uppercase tracking-widest">台北 (TPE)</div>
                        </div>
                        <div class="flex-grow px-6 relative h-10 flex items-center">
                            <div class="w-full h-[1px] border-t-2 border-dashed border-slate-200"></div>
                            <i class="fas fa-plane absolute left-1/2 -translate-x-1/2 text-red-500 bg-white p-2 text-xl"></i>
                        </div>
                        <div class="text-center z-10">
                            <div class="text-4xl font-black italic tracking-tighter">19:35</div>
                            <div class="text-[10px] font-bold text-slate-400 mt-2 uppercase tracking-widest">大阪 (KIX)</div>
                        </div>
                    </div>
                    <div class="text-center text-xs text-slate-400 font-medium">抵達後第一站：JR 綠色窗口領取 5 日券</div>
                </div>

                <!-- Flight Return -->
                <div class="glass-card p-10 relative overflow-hidden group">
                    <div class="flex justify-between items-start mb-10">
                        <div class="bg-slate-800 text-white px-4 py-1 rounded-full text-[10px] font-black tracking-widest uppercase">EVA AIR BR129</div>
                        <span class="text-sm font-bold text-slate-400">2026/05/14 (Thu)</span>
                    </div>
                    <div class="flex justify-between items-center mb-8 relative">
                        <div class="text-center z-10">
                            <div class="text-4xl font-black italic tracking-tighter">12:10</div>
                            <div class="text-[10px] font-bold text-slate-400 mt-2 uppercase tracking-widest">大阪 (KIX)</div>
                        </div>
                        <div class="flex-grow px-6 relative h-10 flex items-center">
                            <div class="w-full h-[1px] border-t-2 border-dashed border-slate-200"></div>
                            <i class="fas fa-plane absolute left-1/2 -translate-x-1/2 text-slate-300 bg-white p-2 text-xl rotate-180"></i>
                        </div>
                        <div class="text-center z-10">
                            <div class="text-4xl font-black italic tracking-tighter">14:30</div>
                            <div class="text-[10px] font-bold text-slate-400 mt-2 uppercase tracking-widest">台北 (TPE)</div>
                        </div>
                    </div>
                    <div class="text-center text-xs text-slate-400 font-medium">建議 09:30 抵達機場辦理登機</div>
                </div>
            </div>
        </section>

        <!-- Stay Section -->
        <section id="stay" class="mb-24 scroll-mt-20">
            <div class="flex items-center gap-6 mb-12">
                <h3 class="text-3xl font-black text-slate-900">住宿基地</h3>
                <div class="h-[2px] flex-grow bg-slate-100"></div>
            </div>
            <div class="glass-card p-4 rounded-[30px] flex flex-col md:flex-row gap-8">
                <div class="md:w-1/3 p-8 flex flex-col justify-center">
                    <div class="text-red-500 font-black mb-2 tracking-widest uppercase text-xs">Primary Node</div>
                    <h4 class="text-3xl font-black mb-4 text-slate-900">Daikokucho Airbnb</h4>
                    <p class="text-slate-500 text-sm leading-relaxed mb-6">
                        位於大國町站 (M21) 5 號出口步行 2 分鐘。鄰近難波與心齋橋，交通封包傳輸極速穩定。
                    </p>
                    <div class="space-y-3">
                        <div class="flex items-center gap-3 text-sm font-bold text-slate-700">
                            <i class="fas fa-subway text-blue-500"></i> 地鐵御堂筋線/四橋線
                        </div>
                        <div class="flex items-center gap-3 text-sm font-bold text-slate-700">
                            <i class="fas fa-walking text-green-500"></i> 出口 5 步行 150 公尺
                        </div>
                    </div>
                </div>
                <div class="md:w-2/3 h-96 rounded-[25px] overflow-hidden shadow-inner border-4 border-white">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3282.023249117621!2d135.49528607624647!3d34.65591557293591!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6000e76669b4ede7%3A0x7bdcc6317ff63f85!2z5aSn5ZyL55S66aeF!5e0!3m2!1szh-TW!2stw!4v1714490000000" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                </div>
            </div>
        </section>

        <!-- Itinerary Detail -->
        <section id="day-itinerary" class="mb-24">
            <div class="flex items-center gap-6 mb-16">
                <h3 class="text-3xl font-black text-slate-900">詳細行程日誌</h3>
                <div class="h-[2px] flex-grow bg-slate-100"></div>
            </div>

            <div class="space-y-24">
                
                <!-- Day 1 -->
                <div id="day1" class="scroll-mt-24">
                    <div class="flex items-center gap-4 mb-8">
                        <span class="text-4xl font-black text-red-100">01</span>
                        <h4 class="text-2xl font-black">5/08 (Fri) 系統上線：入境大阪</h4>
                    </div>
                    <div class="glass-card p-10">
                        <div class="itinerary-step">
                            <div class="font-black text-lg">19:35 降落關西機場 (KIX)</div>
                            <p class="text-sm text-slate-500 mt-1">下機後直奔 2 樓 JR 站，尋找綠色售票機換取 5 日券。</p>
                        </div>
                        <div class="itinerary-step">
                            <div class="font-black text-lg">交通銜接：機場 $\rightarrow$ 大國町</div>
                            <p class="text-sm text-slate-500 mt-1">搭乘 Haruka 特急至天王寺，轉乘地鐵御堂筋線至大國町。</p>
                        </div>
                        <div class="itinerary-step">
                            <div class="font-black text-lg">Check-in Airbnb</div>
                            <p class="text-sm text-slate-500 mt-1">大國町 5 號出口，安放行李後可在難波/心齋橋進行首晚補給。</p>
                        </div>
                    </div>
                </div>

                <!-- Day 2 -->
                <div id="day2" class="scroll-mt-24">
                    <div class="flex items-center gap-4 mb-8">
                        <span class="text-4xl font-black text-red-100">02</span>
                        <h4 class="text-2xl font-black">5/09 (Sat) 白鷺之巔：姬路城與神戶</h4>
                    </div>
                    <div class="glass-card p-10 border-l-8 border-red-500">
                        <div class="flex flex-col md:flex-row gap-10">
                            <div class="md:w-1/3">
                                <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100">
                                    <div class="text-[10px] font-black text-red-500 uppercase tracking-widest mb-4">Shinkansen Logic</div>
                                    <div class="space-y-4">
                                        <div class="flex justify-between">
                                            <span class="text-xs">新大阪發車</span>
                                            <span class="font-bold">08:12</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-xs">抵達姬路</span>
                                            <span class="font-bold">08:41</span>
                                        </div>
                                    </div>
                                    <div class="mt-6 pt-6 border-t text-xs text-slate-400 italic">
                                        *推薦搭乘 Nozomi，速度最快。
                                    </div>
                                </div>
                            </div>
                            <div class="md:w-2/3 space-y-8">
                                <div class="itinerary-step">
                                    <div class="font-black text-lg">姬路城 (白鷺城)</div>
                                    <p class="text-sm text-slate-500 mt-1">日本首批世界遺產。建議一早入城避開人潮，攻頂天守閣。</p>
                                </div>
                                <div class="itinerary-step">
                                    <div class="font-black text-lg">神戶三之宮：午間饗宴</div>
                                    <p class="text-sm text-slate-500 mt-1">搭乘新幹線至新神戶，轉往三之宮品嚐正統神戶牛排。</p>
                                </div>
                                <div class="itinerary-step">
                                    <div class="font-black text-lg">神戶港夜景 & 摩耶山</div>
                                    <p class="text-sm text-slate-500 mt-1">欣賞千萬美金夜景，最後搭乘 JR 新快速輕鬆返回大阪。</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Day 3 -->
                <div id="day3" class="scroll-mt-24">
                    <div class="flex items-center gap-4 mb-8">
                        <span class="text-4xl font-black text-blue-100">03</span>
                        <h4 class="text-2xl font-black text-blue-900">5/10 (Sun) 海之京都：天橋立 & 伊根</h4>
                    </div>
                    <div class="glass-card p-10 border-l-8 border-blue-500 bg-blue-50/10">
                        <div class="flex flex-wrap justify-between gap-6 mb-12">
                            <div class="flex items-center gap-4">
                                <div class="p-3 bg-white rounded-xl shadow-sm text-blue-600 text-xl"><i class="fas fa-train"></i></div>
                                <div>
                                    <div class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Key Train</div>
                                    <div class="font-black text-lg text-blue-900 italic">Hashidate 1 @ 08:38</div>
                                </div>
                            </div>
                            <div class="flex items-center gap-4">
                                <div class="p-3 bg-white rounded-xl shadow-sm text-blue-600 text-xl"><i class="fas fa-anchor"></i></div>
                                <div>
                                    <div class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Priority</div>
                                    <div class="font-black text-lg text-blue-900">伊根舟屋船巡</div>
                                </div>
                            </div>
                        </div>
                        <div class="space-y-8">
                            <div class="itinerary-step">
                                <div class="font-black text-lg text-blue-900">天橋立：飛龍觀</div>
                                <p class="text-sm text-slate-600 mt-1">搭乘纜車登頂，飽覽日本三景。接著租單車穿越 3.6km 沙洲松林。</p>
                            </div>
                            <div class="itinerary-step">
                                <div class="font-black text-lg text-blue-900">丹後巴士轉乘：前往伊根</div>
                                <p class="text-sm text-slate-600 mt-1">從天橋立站搭乘巴士，約 60 分鐘抵達被稱為「日本威尼斯」的伊根。</p>
                            </div>
                            <div class="itinerary-step">
                                <div class="font-black text-lg text-blue-900">伊根舟屋：海上散策</div>
                                <p class="text-sm text-slate-600 mt-1">參加觀光船餵食海鷗，從海面欣賞 230 餘間沿岸舟屋。末班特急回程為 19:05。</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Day 4 -->
                <div id="day4" class="scroll-mt-24">
                    <div class="flex items-center gap-4 mb-8">
                        <span class="text-4xl font-black text-pink-100">04</span>
                        <h4 class="text-2xl font-black">5/11 (Mon) 逆向工程：嵐山小火車</h4>
                    </div>
                    <div class="glass-card p-10 border-l-8 border-pink-400">
                        <div class="bg-pink-50 p-6 rounded-3xl mb-10 flex flex-col md:flex-row justify-between items-center gap-6">
                            <div>
                                <div class="text-pink-600 font-black text-xs tracking-widest uppercase mb-1">Booking Confirmation</div>
                                <h5 class="text-2xl font-black text-pink-900">嵯峨野 4 號 | 10:30 發車</h5>
                                <p class="text-xs text-pink-500 mt-1">車廂 3 / 座位 1A, 1D, 3A</p>
                            </div>
                            <img src="image_78428c.jpg" alt="Logo" class="w-16 h-16 rounded-full border-4 border-white shadow-md">
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 text-sm text-slate-500">
                            <div class="itinerary-step">
                                <div class="font-black text-lg text-slate-800">JR 馬堀進站策略</div>
                                <p class="mt-2">大國町 $\rightarrow$ 京都 $\rightarrow$ 馬堀。步行 10 分鐘穿越田野抵達小火車龜岡站。這是最不擁擠的逆向玩法。</p>
                            </div>
                            <div class="itinerary-step">
                                <div class="font-black text-lg text-slate-800">嵐山下車：一路下坡</div>
                                <p class="mt-2">在「小火車嵐山站」下車，直接抵達竹林小徑頂部。一路經過天龍寺、商店街抵達渡月橋。</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Days 5 & 6 -->
                <div id="day5-6" class="grid grid-cols-1 md:grid-cols-2 gap-8 scroll-mt-24">
                    <div id="day5" class="glass-card p-10 border-t-8 border-green-500">
                        <div class="flex items-center gap-4 mb-6">
                            <span class="text-3xl font-black text-green-100">05</span>
                            <h4 class="text-xl font-black">5/12 京都與宇治</h4>
                        </div>
                        <ul class="space-y-4 text-sm text-slate-500">
                            <li><i class="fas fa-check text-green-500 mr-2"></i><b>伏見稻荷：</b> 千本鳥居清晨散策。</li>
                            <li><i class="fas fa-check text-green-500 mr-2"></i><b>宇治平等院：</b> 欣賞 10 圓硬幣上的鳳凰堂。</li>
                            <li><i class="fas fa-check text-green-500 mr-2"></i><b>職人抹茶：</b> 中村藤吉本店體驗。</li>
                        </ul>
                    </div>
                    <div id="day6" class="glass-card p-10 border-t-8 border-yellow-500">
                        <div class="flex items-center gap-4 mb-6">
                            <span class="text-3xl font-black text-yellow-100">06</span>
                            <h4 class="text-xl font-black">5/13 大阪職人補給</h4>
                        </div>
                        <ul class="space-y-4 text-sm text-slate-500">
                            <li><i class="fas fa-shopping-bag text-yellow-500 mr-2"></i><b>黑門市場：</b> 男人的海鮮早餐。</li>
                            <li><i class="fas fa-plug text-yellow-500 mr-2"></i><b>日本橋電器街：</b> 二手相機與配件搜尋。</li>
                            <li><i class="fas fa-beer text-yellow-500 mr-2"></i><b>道頓堀慶功：</b> 最後一晚的酒精與串炸。</li>
                        </ul>
                    </div>
                </div>

                <!-- Day 7 -->
                <div id="day7" class="scroll-mt-24">
                    <div class="flex items-center gap-4 mb-8">
                        <span class="text-4xl font-black text-slate-100">07</span>
                        <h4 class="text-2xl font-black">5/14 (Thu) 系統登出：回傳台灣</h4>
                    </div>
                    <div class="glass-card p-10 bg-slate-50 border-dashed border-2 border-slate-200">
                        <div class="flex justify-between items-center">
                            <div>
                                <div class="font-black text-lg">09:30 抵達關西機場 (KIX)</div>
                                <p class="text-sm text-slate-400 mt-1">從大國町步行至難波，搭乘南海電鐵 Rapi:t 僅需 40 分鐘。</p>
                            </div>
                            <div class="text-right">
                                <div class="text-[10px] font-black text-red-500 uppercase tracking-widest">EVA AIR</div>
                                <div class="text-3xl font-black italic">12:10</div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

    </main>

    <!-- Scroll Script -->
    <script>
        // 櫻花飄落
        const container = document.getElementById('sakura-box');
        const count = 35;
        function createPetal() {
            const petal = document.createElement('div');
            petal.classList.add('petal');
            const size = Math.random() * 8 + 5 + 'px';
            petal.style.width = size;
            petal.style.height = size;
            petal.style.left = Math.random() * 100 + 'vw';
            petal.style.animationDuration = Math.random() * 5 + 8 + 's';
            petal.style.animationDelay = Math.random() * 5 + 's';
            container.appendChild(petal);
            petal.addEventListener('animationend', () => { petal.remove(); createPetal(); });
        }
        for (let i = 0; i < count; i++) { setTimeout(createPetal, i * 200); }

        // Sidebar Navigation Link Active State
        const sections = document.querySelectorAll('section, div[id^="day"]');
        const navLinks = document.querySelectorAll('.nav-link');

        window.addEventListener('scroll', () => {
            let current = '';
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                const sectionHeight = section.clientHeight;
                if (pageYOffset >= sectionTop - 150) {
                    current = section.getAttribute('id');
                }
            });

            navLinks.forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('href').includes(current)) {
                    link.classList.add('active');
                }
            });
        });
    </script>
</body>
</html>
